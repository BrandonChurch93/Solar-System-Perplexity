diff --git a/tests/starcut.test.ts b/tests/starcut.test.ts
new file mode 100644
index 00000000..3ae38e63
--- /dev/null
+++ b/tests/starcut.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest'
+import { starLeast } from '../src/space/sky'
+import { SIZE } from '../src/space/travel/field'
+import skyFrame from '../src/space/skyframe.json'
+
+const samples = (drawn: number, core: number, px: number, py: number): number => {
+  let sum = 0
+  for (let j = -12; j <= 12; j++) {
+    for (let i = -12; i <= 12; i++) {
+      const dx = i - px
+      const dy = j - py
+      if (Math.abs(dx) < drawn / 2 && Math.abs(dy) < drawn / 2) sum += Math.exp(-(dx * dx + dy * dy) / core)
+    }
+  }
+  return sum
+}
+
+const swing = (drawn: number, core: number): [number, number] => {
+  let least = Infinity
+  let most = 0
+  for (let a = 0; a <= 20; a++) {
+    for (let b = 0; b <= 20; b++) {
+      const s = samples(drawn, core, a / 20, b / 20) / (Math.PI * core)
+      least = Math.min(least, s)
+      most = Math.max(most, s)
+    }
+  }
+  return [least, most]
+}
+
+describe('a star sprite is drawn to where its core has died', () => {
+  const core = skyFrame.stars.core
+
+  it('the sprite cut at the least size of the law loses light by the place on the grid', () => {
+    const [least, most] = swing(SIZE[0], core)
+    expect(most - least).toBeGreaterThan(0.1)
+  })
+
+  it('the drawn width keeps the light of the smallest star at any place on the grid', () => {
+    const drawn = Math.max(SIZE[0], starLeast(core))
+    expect(drawn).toBeGreaterThan(SIZE[0])
+    expect(drawn).toBeLessThan(SIZE[2])
+    const [least, most] = swing(drawn, core)
+    expect(least).toBeGreaterThan(0.99)
+    expect(most).toBeLessThan(1.01)
+  })
+
+  it('a star larger than the drawn width is drawn at its own size', () => {
+    for (const size of [5, 8, SIZE[2]]) expect(Math.max(size, starLeast(core))).toBe(size)
+  })
+})
